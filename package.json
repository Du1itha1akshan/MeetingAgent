{
  "name": "meeting-agent",
  "version": "2.0.0",
  "description": "Azure Functions app that joins scheduled Teams meetings' transcript pipeline, summarizes with Claude, and publishes to GitHub — fully automated, no server to babysit.",
  "main": "dist/functions/*.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "func start",
    "prestart": "npm run build"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "@azure/identity": "^4.0.0",
    "@azure/keyvault-secrets": "^4.6.0",
    "@azure/data-tables": "^13.0.0",
    "@azure/storage-queue": "^12.17.0",
    "@azure/msal-node": "^2.6.0",
    "@octokit/rest": "^20.0.0",
    "@octokit/auth-app": "^6.0.0",
    "@anthropic-ai/sdk": "^0.32.1",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "azure-functions-core-tools": "^4.0.5455",
    "typescript": "^5.4.0",
    "@types/node": "^24.0.0"
  }
}
