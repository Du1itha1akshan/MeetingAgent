# This project runs as an Azure Functions app now (see host.json, src/functions/).
#
# For local development: copy local.settings.json.example -> local.settings.json
# and fill it in there — `func start` reads that file, not .env.
#
# In Azure: non-secret values below are Function App application settings
# (set by infra/main.bicep); AZURE_CLIENT_SECRET, ANTHROPIC_API_KEY,
# GRAPH_CLIENT_STATE, and GITHUB_APP_PRIVATE_KEY live in Key Vault instead
# (see scripts/deploy.ps1) and are pulled in by src/config.ts at cold start.
#
# This file just documents every variable name the app reads.

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=            # Key Vault secret: azure-client-secret

MONITORED_USERS=                # comma-separated UPNs/user IDs

NOTIFICATION_URL=                # https://<function-app>.azurewebsites.net/api/graph/notifications
GRAPH_CLIENT_STATE=              # Key Vault secret: graph-client-state

ANTHROPIC_API_KEY=               # Key Vault secret: anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-6

GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_BASE_PATH=meetings
CREATE_ISSUES_FOR_ACTION_ITEMS=true
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=          # Key Vault secret: github-app-private-key
GITHUB_APP_INSTALLATION_ID=

POLL_LOOKBACK_MINUTES=20

# Set automatically by Azure — do not set by hand in production:
# KEY_VAULT_URI, AzureWebJobsStorage, STATE_TABLE_ENDPOINT, QUEUE_ENDPOINT
