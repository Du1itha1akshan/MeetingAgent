# This project runs as an Azure Functions app now (see host.json, src/functions/).
#
# For local development: copy local.settings.json.example -> local.settings.json
# and fill it in there — `func start` reads that file, not .env.
#
# In Azure: non-secret values below are Function App application settings
# (set by infra/main.bicep); AZURE_CLIENT_SECRET, ANTHROPIC_API_KEY,
# GRAPH_CLIENT_STATE, and GITHUB_APP_PRIVATE_KEY live in Key Vault instead
# (see scripts/deploy.ps1) and are pulled in by src/config.ts at cold start.
#
# This file just documents every variable name the app reads.

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=            # Key Vault secret: azure-client-secret

MONITORED_USERS=                # comma-separated UPNs/user IDs

NOTIFICATION_URL=                # https://<function-app>.azurewebsites.net/api/graph/notifications
GRAPH_CLIENT_STATE=              # Key Vault secret: graph-client-state

ANTHROPIC_API_KEY=               # Key Vault secret: anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-6

GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_BASE_PATH=meetings
CREATE_ISSUES_FOR_ACTION_ITEMS=true
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=          # Key Vault secret: github-app-private-key
GITHUB_APP_INSTALLATION_ID=

POLL_LOOKBACK_MINUTES=20

# The JRC Meeting Assistant posting to a meeting's chat once it has started
# (src/greeting.ts, src/graph/assistantAuth.ts). Off unless exactly "true".
GREETING_ENABLED=false
ASSISTANT_USERNAME=              # the assistant's UPN
# ASSISTANT_SCOPE=https://graph.microsoft.com/ChatMessage.Send offline_access
# GREETING_MESSAGE=<p>...</p>        # HTML; default is the "Shall I start transcription?" text in src/config.ts
# Answering the greeting's question (src/transcriptionQuestion.ts): the first "yes"/"no"
# in the chat decides. "no" posts "This meeting will not be transcribed."; "yes" joins
# the call and starts Teams transcription only if this is "true" (needs the
# Calls.JoinGroupCall.All permission and a calling bot registration), otherwise it
# posts how to start transcription from Teams.
START_TRANSCRIPTION_ON_YES=false
# TRANSCRIPTION_ANSWER_WINDOW_MINUTES=15
# CALLS_CALLBACK_URL=             # default: https://<function-app host>/api/calls/callback
# Key Vault secrets: assistant-password (its password) and assistant-refresh-token
# (rewritten by the app after every sign-in; any placeholder to start with).

# Set automatically by Azure — do not set by hand in production:
# KEY_VAULT_URI, AzureWebJobsStorage, STATE_TABLE_ENDPOINT, QUEUE_ENDPOINT
